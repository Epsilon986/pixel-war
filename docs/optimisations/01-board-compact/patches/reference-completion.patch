+++ b/src/main/java/org/pixelwar/pixelwar/HttpPerformanceFilter.java
@@ -0,0 +1,72 @@
+package org.pixelwar.pixelwar;
+
+import jakarta.servlet.FilterChain;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import java.io.IOException;
+import java.util.Arrays;
+import org.pixelwar.pixelwar.domain.PerformanceTracker;
+import org.pixelwar.pixelwar.domain.Simulation;
+import org.springframework.stereotype.Component;
+import org.springframework.web.filter.OncePerRequestFilter;
+
+/** Bounded sliding windows of completed API requests, including controller waits and serialization. */
+@Component
+public final class HttpPerformanceFilter extends OncePerRequestFilter {
+    private static final String EPOCH_ATTRIBUTE = HttpPerformanceFilter.class.getName() + ".epoch";
+    public record Percentiles(int samples, Long p95Nanos, Long p99Nanos) {}
+    public record Snapshot(Percentiles reads, Percentiles commands, Long completedRequestsBlockedNanos, int windowCapacity) {}
+    private final Window reads = new Window(512), commands = new Window(512);
+    private final PerformanceTracker.Probe probe = PerformanceTracker.jvmProbe();
+    private final Simulation simulation;
+    private long generation, blockedNanos;
+    private boolean blockedSupported;
+    public HttpPerformanceFilter(Simulation simulation) { this.simulation = simulation; }
+
+    @Override protected boolean shouldNotFilter(HttpServletRequest request) { return !request.getRequestURI().startsWith("/api/"); }
+    @Override protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain chain)
+            throws ServletException, IOException {
+        long epoch;
+        synchronized (this) { epoch = generation; }
+        long thread = Thread.currentThread().threadId(), blockedBefore = probe.blockedMillis(thread), start = System.nanoTime();
+        try { chain.doFilter(request, response); }
+        finally {
+            long duration = System.nanoTime() - start, blockedAfter = probe.blockedMillis(thread);
+            var resetEpoch = request.getAttribute(EPOCH_ATTRIBUTE);
+            Long completedAt = simulation == null ? null : simulation.trialCompletedAtNanos();
+            if (completedAt == null || start <= completedAt) {
+                record(resetEpoch instanceof Long value ? value : epoch, "GET".equals(request.getMethod()), duration, blockedBefore, blockedAfter);
+            }
+        }
+    }
+    synchronized void record(long epoch, boolean read, long duration, long before, long after) {
+        if (epoch != generation) return;
+        (read ? reads : commands).add(duration);
+        if (before >= 0 && after >= before) { blockedSupported = true; blockedNanos += (after - before) * 1_000_000L; }
+    }
+    public synchronized void reset() {
+        generation++;
+        reads.clear(); commands.clear(); blockedNanos = 0; blockedSupported = false;
+    }
+    public synchronized void resetIncluding(HttpServletRequest request) {
+        reset();
+        request.setAttribute(EPOCH_ATTRIBUTE, generation);
+    }
+    public synchronized Snapshot snapshot() {
+        return new Snapshot(reads.snapshot(), commands.snapshot(), blockedSupported ? blockedNanos : null, 512);
+    }
+    static final class Window {
+        private final long[] durations;
+        private int size, next;
+        Window(int capacity) { durations = new long[capacity]; }
+        void add(long nanos) { durations[next] = nanos; next = (next + 1) % durations.length; size = Math.min(size + 1, durations.length); }
+        void clear() { size = next = 0; }
+        Percentiles snapshot() {
+            if (size == 0) return new Percentiles(0, null, null);
+            var sorted = Arrays.copyOf(durations, size);
+            Arrays.sort(sorted);
+            return new Percentiles(size, sorted[(int) Math.ceil(size * .95) - 1], sorted[(int) Math.ceil(size * .99) - 1]);
+        }
+    }
+}
diff --git a/src/main/java/org/pixelwar/pixelwar/domain/PerformanceTracker.java b/src/main/java/org/pixelwar/pixelwar/domain/PerformanceTracker.java
new file mode 100644
index 0000000..a33dcc7
--- /dev/null
+++ b/src/main/java/org/pixelwar/pixelwar/domain/PerformanceTracker.java
@@ -0,0 +1,93 @@
+package org.pixelwar.pixelwar.domain;
+
+import java.lang.management.ManagementFactory;
+
+/** Engine resources only. Samples at boundaries and every 100 ms, never per placement. */
+public final class PerformanceTracker {
+    public interface Probe {
+        long cpuNanos(long threadId);
+        long allocatedBytes(long threadId);
+        long blockedMillis(long threadId);
+        long heapBytes();
+    }
+    public record Snapshot(long actions, long attempts, long elapsedNanos, double attemptsPerSecond,
+                           Long cpuNanos, Double allocatedBytesPerAction, long peakObservedHeapBytes,
+                           Long engineBlockedNanos) {}
+    private final Probe probe;
+    private long threadId = -1, startedAt = -1, lastSampleAt, peakHeap;
+    private long cpu, allocated, blocked, previousCpu = -1, previousAllocated = -1, previousBlocked = -1;
+    private boolean active, cpuSupported, allocationSupported, contentionSupported;
+
+    public PerformanceTracker(Probe probe) { this.probe = probe; reset(); }
+
+    public void reset() {
+        threadId = startedAt = -1;
+        active = cpuSupported = allocationSupported = contentionSupported = false;
+        cpu = allocated = blocked = lastSampleAt = 0;
+        previousCpu = previousAllocated = previousBlocked = -1;
+        peakHeap = probe.heapBytes();
+    }
+    public void beginAction(long elapsedNanos) {
+        long current = Thread.currentThread().threadId();
+        if (startedAt < 0) startedAt = elapsedNanos;
+        if (!active || current != threadId) {
+            if (active) sample(elapsedNanos);
+            threadId = current;
+            previousCpu = probe.cpuNanos(threadId);
+            previousAllocated = probe.allocatedBytes(threadId);
+            previousBlocked = probe.blockedMillis(threadId);
+            cpuSupported = previousCpu >= 0;
+            allocationSupported = previousAllocated >= 0;
+            contentionSupported = previousBlocked >= 0;
+            active = true;
+        }
+    }
+    public void tick(long elapsedNanos) {
+        if (elapsedNanos - lastSampleAt >= 100_000_000L) sample(elapsedNanos);
+    }
+    public void pause(long elapsedNanos) {
+        if (active) sample(elapsedNanos);
+        active = false;
+    }
+    private void sample(long elapsedNanos) {
+        peakHeap = Math.max(peakHeap, probe.heapBytes());
+        lastSampleAt = elapsedNanos;
+        if (!active) return;
+        long nextCpu = probe.cpuNanos(threadId), nextAllocated = probe.allocatedBytes(threadId), nextBlocked = probe.blockedMillis(threadId);
+        if (previousCpu >= 0 && nextCpu >= previousCpu) cpu += nextCpu - previousCpu;
+        if (previousAllocated >= 0 && nextAllocated >= previousAllocated) allocated += nextAllocated - previousAllocated;
+        if (previousBlocked >= 0 && nextBlocked >= previousBlocked) blocked += nextBlocked - previousBlocked;
+        cpuSupported &= nextCpu >= 0;
+        allocationSupported &= nextAllocated >= 0;
+        contentionSupported &= nextBlocked >= 0;
+        previousCpu = nextCpu; previousAllocated = nextAllocated; previousBlocked = nextBlocked;
+    }
+    public Snapshot snapshot(long elapsedNanos, long actions, long attempts) {
+        if (active) sample(elapsedNanos);
+        long duration = startedAt < 0 ? 0 : Math.max(0, elapsedNanos - startedAt);
+        return new Snapshot(actions, attempts, duration, duration == 0 ? 0 : attempts * 1e9 / duration,
+                actions == 0 || !cpuSupported ? null : cpu,
+                actions == 0 || !allocationSupported ? null : allocated / (double) actions, peakHeap,
+                actions == 0 || !contentionSupported ? null : blocked * 1_000_000L);
+    }
+    public static Probe jvmProbe() { return JvmProbe.INSTANCE; }
+    private static final class JvmProbe implements Probe {
+        static final JvmProbe INSTANCE = new JvmProbe();
+        private final java.lang.management.ThreadMXBean threads = ManagementFactory.getThreadMXBean();
+        private final com.sun.management.ThreadMXBean extended = threads instanceof com.sun.management.ThreadMXBean bean ? bean : null;
+        private final java.lang.management.MemoryMXBean memory = ManagementFactory.getMemoryMXBean();
+        private JvmProbe() {
+            try { if (threads.isThreadCpuTimeSupported()) threads.setThreadCpuTimeEnabled(true); } catch (UnsupportedOperationException | SecurityException ignored) {}
+            try { if (threads.isThreadContentionMonitoringSupported()) threads.setThreadContentionMonitoringEnabled(true); } catch (UnsupportedOperationException | SecurityException ignored) {}
+            try { if (extended != null && extended.isThreadAllocatedMemorySupported()) extended.setThreadAllocatedMemoryEnabled(true); } catch (UnsupportedOperationException | SecurityException ignored) {}
+        }
+        public long cpuNanos(long id) { return threads.isThreadCpuTimeSupported() && threads.isThreadCpuTimeEnabled() ? threads.getThreadCpuTime(id) : -1; }
+        public long allocatedBytes(long id) { return extended != null && extended.isThreadAllocatedMemorySupported() && extended.isThreadAllocatedMemoryEnabled() ? extended.getThreadAllocatedBytes(id) : -1; }
+        public long blockedMillis(long id) {
+            if (!threads.isThreadContentionMonitoringSupported() || !threads.isThreadContentionMonitoringEnabled()) return -1;
+            var info = threads.getThreadInfo(id);
+            return info == null ? -1 : info.getBlockedTime();
+        }
+        public long heapBytes() { return memory.getHeapMemoryUsage().getUsed(); }
+    }
+}
diff --git a/src/test/java/org/pixelwar/pixelwar/HttpPerformanceFilterTests.java b/src/test/java/org/pixelwar/pixelwar/HttpPerformanceFilterTests.java
new file mode 100644
index 0000000..45fa9eb
--- /dev/null
+++ b/src/test/java/org/pixelwar/pixelwar/HttpPerformanceFilterTests.java
@@ -0,0 +1,85 @@
+package org.pixelwar.pixelwar;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import org.pixelwar.pixelwar.domain.PerformanceTracker;
+import org.pixelwar.pixelwar.domain.Simulation;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.mock.web.MockHttpServletResponse;
+
+class HttpPerformanceFilterTests {
+    @Test void requestsAfterTrialCompletionDoNotDiluteItsPercentiles() throws Exception {
+        var simulation = mock(Simulation.class);
+        when(simulation.trialCompletedAtNanos()).thenReturn(System.nanoTime() - 1_000_000);
+        var filter = new HttpPerformanceFilter(simulation);
+        filter.doFilter(new MockHttpServletRequest("GET", "/api/performance"), new MockHttpServletResponse(), (request, response) -> {});
+        assertEquals(0, filter.snapshot().reads().samples());
+        when(simulation.trialCompletedAtNanos()).thenReturn(null);
+        filter.doFilter(new MockHttpServletRequest("GET", "/api/performance"), new MockHttpServletResponse(), (request, response) -> {});
+        assertEquals(1, filter.snapshot().reads().samples());
+    }
+
+    @Test void realMonitorContentionIsProfiledAndIncludedInHttpLatency() throws Exception {
+        org.junit.jupiter.api.Assumptions.assumeTrue(PerformanceTracker.jvmProbe().blockedMillis(Thread.currentThread().threadId()) >= 0);
+        var lock = new Object();
+        var acquired = new CountDownLatch(1);
+        var release = new CountDownLatch(1);
+        var holder = new Thread(() -> {
+            synchronized (lock) {
+                acquired.countDown();
+                try { release.await(5, TimeUnit.SECONDS); } catch (InterruptedException exception) { Thread.currentThread().interrupt(); }
+            }
+        });
+        holder.start();
+        assertTrue(acquired.await(2, TimeUnit.SECONDS));
+        var releaser = new Thread(() -> {
+            try { Thread.sleep(50); } catch (InterruptedException exception) { Thread.currentThread().interrupt(); }
+            release.countDown();
+        });
+        try {
+            var filter = new HttpPerformanceFilter(null);
+            releaser.start();
+            filter.doFilter(new MockHttpServletRequest("GET", "/api/performance"), new MockHttpServletResponse(), (request, response) -> {
+                synchronized (lock) { /* A controller blocked by the engine monitor. */ }
+            });
+            assertTrue(filter.snapshot().completedRequestsBlockedNanos() > 0);
+            // ThreadMXBean rounds cumulative blocked time to milliseconds, unlike nanoTime.
+            assertTrue(filter.snapshot().reads().p95Nanos() + 1_000_000 >= filter.snapshot().completedRequestsBlockedNanos());
+        } finally {
+            release.countDown(); holder.join(2000); releaser.join(2000);
+        }
+    }
+    @Test void percentilesUseNearestRankAndBoundedRecentWindow() {
+        var window = new HttpPerformanceFilter.Window(100);
+        assertNull(window.snapshot().p95Nanos());
+        assertEquals(0, window.snapshot().samples());
+        for (int i = 1; i <= 100; i++) window.add(i);
+        assertEquals(95L, window.snapshot().p95Nanos());
+        assertEquals(99L, window.snapshot().p99Nanos());
+        for (int i = 1; i <= 100; i++) window.add(200);
+        assertEquals(100, window.snapshot().samples());
+        assertEquals(200L, window.snapshot().p95Nanos());
+        assertEquals(200L, window.snapshot().p99Nanos());
+        window.clear();
+        assertEquals(0, window.snapshot().samples());
+    }
+    @Test void resetRejectsRequestsFromPreviousGenerationAndSeparatesCommandsFromReads() {
+        var filter = new HttpPerformanceFilter(null);
+        filter.record(0, true, 100, 10, 12);
+        filter.record(0, false, 200, 12, 15);
+        var result = filter.snapshot();
+        assertEquals(100L, result.reads().p95Nanos());
+        assertEquals(200L, result.commands().p99Nanos());
+        assertEquals(5_000_000L, result.completedRequestsBlockedNanos());
+        filter.reset();
+        filter.record(0, true, 999, 0, 999);
+        assertEquals(0, filter.snapshot().reads().samples());
+        assertNull(filter.snapshot().completedRequestsBlockedNanos());
+        filter.record(1, true, 20, -1, -1);
+        assertEquals(20L, filter.snapshot().reads().p95Nanos());
+        assertNull(filter.snapshot().completedRequestsBlockedNanos());
+    }
+}
diff --git a/src/test/java/org/pixelwar/pixelwar/PerformanceApiTests.java b/src/test/java/org/pixelwar/pixelwar/PerformanceApiTests.java
